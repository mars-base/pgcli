---
# EXAMPLE ONLY: copy to main.yml (gitignored) and adjust.
# Secrets and host-specific values are placeholders.
# Single-node add-on test group. All addon_<type>_* variables live in this
# file; select one type at runtime with -e addon_type=<type>:
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_single \
#     --tags addon -e addon_type=haproxy
#
# Omitting addon_type makes the add-on play a no-op.
#
# Every entry needs type plus exactly one of name (top-level) or instance
# (instance-scoped). Optional fields:
#   state       present (default) or absent. To clean a group up, set that
#               entry to absent and rerun the same command; the role removes
#               the container and deletes its data by default (clean_data:
#               false keeps it).
#   params      complete `pg addon install` flag list for this entry. It
#               replaces the group-level addon_<type>_params; entries without
#               params inherit that shared list. Supported for every add-on
#               type, so multiple instances of the same type can use different
#               ports, data directories, memory limits, and so on.
#   args        extra flags appended verbatim after the resolved params.
#   conf        inline config, overriding the shared addon_<type>_conf
#               (nginx/haproxy/prometheus/alertmanager only).
#   clean_data  with state: absent, delete data where supported (default true).
#   force       with state: present, reinstall with `pg addon install --force`.
#   autostart   enable boot autostart (default true).
#
# Because an entry's params replaces addon_<type>_params, repeat any shared
# flags in each entry (or use YAML anchors).
_addon_kind: "{{ addon_type | default('') }}"
pgcli_addons: "{{ lookup('vars', 'addon_' ~ _addon_kind ~ '_addons', default=[]) }}"
pgcli_instances: "{{ lookup('vars', 'addon_' ~ _addon_kind ~ '_instances', default=[]) }}"


# ===== alertmanager =====
# Single-node test group for the alertmanager add-on.

# Default flags for alertmanager entries that do not set their own params.
addon_alertmanager_params: []
# Example:
#   - "--data-dir=/data/pg/addon/alertmanager/am1"
#
# Inline config file, written under <pgcli config dir>/addons/ and
# passed as --conf-file (mutually exclusive with its rendered-config flags).
addon_alertmanager_conf: ""
# Example:
#   route:
#     receiver: noop
#   receivers:
#     - name: noop

addon_alertmanager_addons:
  - type: alertmanager
    state: present
    name: am1


# ===== beegfs =====
# Single-node test group for the beegfs add-on.

# Default flags for beegfs entries that do not set their own params.
addon_beegfs_params: []
# Example:
