addon_pgdog_params:
  - "--backend"
  - "app=127.0.0.1:35432:postgres"
  - "--user"
  - "appuser:<secret>:app"
  - "--sharded-table"
  - "app:users:id:bigint"

addon_pgdog_addons:
  - type: pgdog
    state: present
    name: pgdog1


