---
# vmcluster standalone add-on group (addon_vmcluster_single).
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_vmcluster_single --tags addon

# Single-node test group for the vmcluster add-on.

# Default flags for vmcluster entries that do not set their own params.
addon_vmcluster_single_params: []
# Example:
#   - "--data-dir=/data/pg/addon/vmcluster/vmc1"

addon_vmcluster_single_addons:
  - type: vmcluster
    state: present
    name: vmc1


