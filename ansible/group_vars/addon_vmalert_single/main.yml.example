---
# vmalert standalone add-on group (addon_vmalert_single).
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_vmalert_single --tags addon

# Single-node test group for the vmalert add-on.

# Default flags for vmalert entries that do not set their own params.
addon_vmalert_single_params: []
# Example:
#   - "--<flag>=<value>"

addon_vmalert_single_addons:
  - type: vmalert
    state: present
    name: vmalert1


