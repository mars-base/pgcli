---
# influx2tsdb standalone add-on group (addon_influx2tsdb_single).
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_influx2tsdb_single --tags addon
#
# The PostgreSQL instance this add-on needs is declared below; create it first:
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_influx2tsdb_single --tags instance,addon

# Single-node test group for the influx2tsdb add-on.
addon_influx2tsdb_single_instances:
  - name: tsdb
    host: "{{ inventory_hostname }}"
    state: started
    extensions:
      - timescaledb
addon_influx2tsdb_single_params:
  - "--pg-name"
  - "tsdb"

# Additional flags, for example:
#   - "--database=metrics"
#   - "--port=8087"
#   - "--pool-size=10"
#   - "--verbose"

addon_influx2tsdb_single_addons:
  - type: influx2tsdb
    state: present
    name: i2t1


