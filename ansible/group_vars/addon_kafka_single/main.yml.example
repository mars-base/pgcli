---
# kafka standalone add-on group (addon_kafka_single).
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_kafka_single --tags addon

# Single-node test group for the kafka add-on.

# Default flags for kafka entries that do not set their own params.
addon_kafka_single_params: []
# Example:
#   - "--data-dir=/data/pg/addon/kafka/kafka1"
#   - "--broker-port=9092"
#   - "--controller-port=19093"
#   - "--config-option=num.partitions=3"
#   - "--tls"

addon_kafka_single_addons:
  - type: kafka
    state: present
    name: kafka1


