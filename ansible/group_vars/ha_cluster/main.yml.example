---
# Example HA group configuration. Copy to main.yml and edit for the real
# environment; group_vars/*/main.yml is gitignored.
#
# HA host role: one Patroni member per namespace. The shared etcd DCS lives in
# group_vars/ha_etcd; the first host in ha_cluster bootstraps every Patroni
# scope and the rest join. apply.yaml runs the HA play with serial: 1 so this
# ordering holds.

# The host-default config (pgcli_config_path, /root/.pgcli/pg.yaml). This
# override sets the namespace it is initialized with; it must match the name of
# the pgcli_namespaces entry whose path is that same directory. The entry is
# matched by path/name, not by list position.
pgcli_config_overrides:
  namespace: ha

# Namespaces for the Patroni clusters below. The ha entry is the host-default
# config (initialized through the overrides above, matched by path); ha2 is an
# extra config the pgcli role initializes automatically because it declares
# base_dir. Every lookup elsewhere is by name, so entry order does not matter.
# Data directories and port ranges must not overlap between namespaces.
pgcli_namespaces:
  - name: ha
    path: /root/.pgcli
  - name: ha2
    path: /root/.pgcli/ha2
    base_dir: /data/pg-ha2
    backup_dir: /mnt/backup/pg-ha2
    pg_start_port: 36432
    pg_ssh_port: 43201

# Which inventory group provides the shared etcd DCS. Several etcd groups can
# coexist in hosts.ini; to switch the DCS, change this variable only — the
# endpoints are derived from the group's hosts automatically. Each etcd host
# exposes its client endpoint as _ha_etcd_client_endpoint in
# group_vars/ha_etcd.
pg_ha_etcd_group: ha_etcd
_ha_dcs_endpoints: >-
  {{ groups[pg_ha_etcd_group]
     | map('extract', hostvars, '_ha_etcd_client_endpoint') | list }}

# Shared S3 repository for WAL archiving and PITR. When pgcli_backup_s3_host
# (or pgcli_backup_s3_endpoint) is set, pg_ha runs `pg backup setup` for every
# namespace config before creating members, so archive parameters are present
# from the first start; on existing members it reconciles them automatically.
# Leave both empty to skip S3 (local snapshot backups still work, but WAL
# archiving and PITR do not). The endpoint is <private_ip>:<port> of
# pgcli_backup_s3_host; its CA is copied from that pgcli-managed store. The
# secret key lives in group_vars/ha_cluster/secrets.yaml (gitignored).
pgcli_backup_s3_host: s3-01
pgcli_backup_s3_port: 9000
pgcli_backup_s3_bucket: pgbackup
pgcli_backup_s3_access_key: admin
# Real deployments keep the secret in group_vars/ha_cluster/secrets.yaml;
# this placeholder is listed so the variable is easy to find.
pgcli_backup_s3_secret_key: "<secret-key>"
# Optional extras (defaults shown):
# pgcli_backup_s3_region: us-east-1
# pgcli_backup_s3_path: /pgbackrest
# pgcli_backup_s3_no_verify_tls: false
# pgcli_backup_s3_ca_file: /path/to/ca.crt
# pgcli_backup_s3_ca_sha256: "<sha256>"
#
# A store that is not a pgcli-managed inventory host: omit
# pgcli_backup_s3_host, set pgcli_backup_s3_endpoint to host:port (no scheme)
# instead, and the role falls back to `pg backup fetch-ca`.

# One Patroni cluster per namespace. The same scope name is safe: pgcli bakes
# the namespace suffix into the DCS scope (pgcluster-ha / pgcluster-ha2).
# members is optional: when omitted, each host uses its inventory_hostname as
# the Patroni member name. Set it only for custom names; the list must follow
# ha_cluster order, stay unique, and match [A-Za-z0-9][A-Za-z0-9_-]{0,31}
# (no FQDNs or IPs). host_port and restapi_port must be disjoint per cluster.
#
# extensions: builtin contrib or Pigsty catalog names only (`pg extension
# available` lists the latter). Every host runs `pg ha extension install` for
# its local members when pg.yaml lacks an entry; after the last member one
# `pg ha extension apply` resumes the cluster, writes
# shared_preload_libraries to the DCS and creates the extensions on the
# leader. extension_database selects the target database for
# CREATE EXTENSION (default: postgres). Removing an entry from the list does
# not uninstall it; use `pg ha extension remove` for that.
#
# state: started | stopped | absent. absent runs on each ha_cluster host in
# serial order: it disables the local members' autostart, removes the members
# and clears the DCS scope (hosts after the first are a clean no-op).
# clean_data: true also deletes each member's data dir; the now-empty
# addon/patroni/<scope> directory itself is left behind. etcd, the backup
# container and the pgBackRest stanza/backups are shared or final copies, so
# they are left intact. Remove the matching HAProxy entry too (state: absent);
# etcd has its own switch (pg_etcd_state: absent in group_vars/ha_etcd) and
# must be destroyed only after the clusters are.
pg_ha_clusters:
  - namespace: ha
    scope: pgcluster
    host_port: 35532
    restapi_port: 8008
    dcs_endpoints: "{{ _ha_dcs_endpoints }}"
    state: started
    autostart: true
    # clean_data: false
    extensions:
      - pg_stat_statements
    # extension_database: postgres
  - namespace: ha2
    scope: pgcluster
    host_port: 35542
    restapi_port: 8018
    dcs_endpoints: "{{ _ha_dcs_endpoints }}"
    state: started
    autostart: true
    # clean_data: false
    extensions:
      - pg_stat_statements
    # extension_database: postgres

# HAProxy in front of both Patroni clusters, one instance per namespace. The
# proxy targets every member of ha_cluster via --node (it usually runs on a
# host that is not a Patroni member, so --ha would be wrong). mode: split gives
# a read/write listener (leader) and a read-only listener (replicas under
# max_lag). Both instances share one host network, so their ports must differ.
# listen defaults to 0.0.0.0 so clients on other hosts can connect; set
# 127.0.0.1 to keep the listeners loopback-only. Set enabled: false to skip the
# proxy play.
#
# Each cluster entry takes state: present (default, create/reconcile) or
# absent (remove the instance from the proxy host and prune its config).
# autostart (top-level default, overridable per entry) brings the proxy up on
# host boot via pg autostart enable --haproxy.
pg_ha_haproxy_host: "{{ groups['ha_cluster'] | first }}"
pg_ha_haproxy:
  enabled: true
  mode: split
  max_lag: 1MB
  listen: 0.0.0.0
  autostart: true
  clusters:
    - namespace: ha
      name: lb-ha
      rw_port: 5000
      ro_port: 5001
      stats_port: 5002
      state: present
    - namespace: ha2
      name: lb-ha2
      rw_port: 5010
      ro_port: 5011
      stats_port: 5012
      state: present
