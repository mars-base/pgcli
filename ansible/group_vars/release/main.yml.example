---
# Example release environment configuration. Copy to main.yml and edit for the
# real environment; group_vars/*/main.yml is gitignored.
#
# An empty list disables standalone instances for this environment. Add
# entries with `host:` when release hosts are added to the inventory.
pgcli_config_overrides:
  namespace: release

pgcli_instances: []
# pgcli_instances:
#   - name: pg01
#     host: release-db-01
#     state: started
#     autostart: true
