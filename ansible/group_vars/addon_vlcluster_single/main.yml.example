---
# vlcluster standalone add-on group (addon_vlcluster_single).
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_vlcluster_single --tags addon

# Single-node test group for the vlcluster add-on.

# Default flags for vlcluster entries that do not set their own params.
addon_vlcluster_single_params: []
# Example:
#   - "--data-dir=/data/pg/addon/vlcluster/vlc1"
#   - "--insert-port=9430"
#   - "--select-port=9431"
#   - "--storage-port=9432"
#   - "--retention=30d"

addon_vlcluster_single_addons:
  - type: vlcluster
    state: present
    name: vlc1


