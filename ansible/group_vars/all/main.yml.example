  - image: docker.io/prom/node-exporter:v1.12.1
    archive: node-exporter_v1.12.1.tar
    auto_load: true
    addons: [nodeexporter]
  - image: docker.io/pgsty/pg_exporter:1.5.0
    archive: pg_exporter_1.5.0.tar
    auto_load: true
    addons: [pgexporter]

# Install-time subset: everything the pgcli role must have before instances
# and add-ons are reconciled. Entries with auto_load: true are excluded here
# and loaded on demand by the pg_addon role instead.
_pgcli_images_install: >-
  {{ (pgcli_images | selectattr('auto_load', 'defined') | rejectattr('auto_load') | list)
     + (pgcli_images | rejectattr('auto_load', 'defined') | list) }}

pgcli_install_path: /usr/local/bin/pg

# Optional: directory that stores this host's namespace pg.yaml. When
# non-empty every pgcli command runs with `-c <pgcli_namespace_path>/pg.yaml`
# (created with `pg config init -o`), so all instances declared in
# pgcli_instances are created inside that namespace. Leave it empty to use
# pgcli_config_path.
# pgcli_namespace_path: /root/.pgcli/dev
pgcli_namespace_path: ""
pgcli_config_path: >-
  {{ (pgcli_namespace_path | regex_replace('/+$', '') ~ '/pg.yaml')
     if pgcli_namespace_path | default('', true) | length > 0
     else (pgcli_deploy_home ~ '/.pgcli/pg.yaml') }}

# Named namespaces shared by every host. Each entry maps a selector name to the
# directory that stores its pg.yaml. An instance picks one with
# `namespace: <name>` in pgcli_instances; instances without it use
# pgcli_namespace_path / pgcli_config_path. Add more entries as needed.
# Lookups are by name, never by list position. The entry whose path resolves to
# pgcli_config_path represents the host-default config: the pgcli role's main
# init task creates it from pgcli_config_overrides.namespace, and the
# extra-namespace loop skips it by path.
#
# An extra entry whose path differs from pgcli_config_path is initialized
# automatically when it also declares `base_dir`. Optional init fields:
#   base_dir, backup_dir, pg_start_port, pg_ssh_port
# Missing fields fall back to pgcli_config; a missing backup_dir lets
# `pg config init` default to <base_dir>/backup. Entries without base_dir keep
# the manual `pg config init -o <path>/pg.yaml` workflow.
pgcli_namespaces:
  - name: default
    path: "{{ pgcli_deploy_home }}/.pgcli"

# Consumed by `pg config init` on the first run only. Editing these later
# does NOT rewrite an existing pg.yaml. Rootless deployments default to
# directories under the deployment account's home.
# Scenario group_vars can build namespaced directories from these roots.
pgcli_data_root: >-
  {{ '/data/pg' if not (pgcli_deploy_rootless | bool)
     else pgcli_deploy_home ~ '/pg/data' }}
pgcli_backup_root: >-
  {{ '/mnt/backup/pg' if not (pgcli_deploy_rootless | bool)
     else pgcli_deploy_home ~ '/pg/backup' }}
pgcli_config_defaults:
  namespace: default
  base_dir: "{{ pgcli_data_root }}"
  backup_dir: "{{ pgcli_backup_root }}"
  pg_start_port: 35432
  pg_ssh_port: 42201

pgcli_config_overrides: {}
pgcli_config: "{{ pgcli_config_defaults | combine(pgcli_config_overrides) }}"

# Per-instance attribute defaults. This is ONE template applied to ONE
# instance at a time, not a list of instances. For every entry in
# pgcli_instances the role computes (shallow merge):
#
#   spec = pgcli_instance_defaults | combine(entry)
#
# Keys set on an entry override the defaults below; missing keys fall back to
# them. `name` cannot be defaulted and must be set on each entry.
#
# state:           present | started | stopped | absent
#                  present = create the instance but leave its run state alone
# namespace:       name from pgcli_namespaces; the instance is created in that
#                  namespace's pg.yaml (-c <path>/pg.yaml). Omit for the host
#                  default (pgcli_namespace_path / pgcli_config_path)
# autostart:       enable the instance at boot (`pg autostart enable`)
# backup_target:   local | s3; fixed at creation time, later changes only warn
# password_length: generated admin password length used by `pg create`
# extensions:      PostgreSQL extensions to install; defaults to
#                  pg_stat_statements. An entry that sets this list replaces
#                  the default list entirely (no append)
# clean_data:      only used with state absent; true also deletes the data and
#                  WAL directories and the pgBackRest stanza. Default false
#                  keeps the host data so a later create reuses it. Fully
#                  destroying an instance needs both state: absent and
#                  clean_data: true; clean_data alone does nothing.
pgcli_instance_defaults:
  state: started
  autostart: false
  backup_target: local
  password_length: 16
  extensions:
    - pg_stat_statements
  clean_data: false

# Desired instances are consumed by the pg_instance role. Each deployment-mode
# group defines pgcli_instances in its own group_vars/<mode>/main.yml and is
# responsible only for that mode. Enable one mode group at a time in the
# inventory; apply.yaml runs a single generic instance play over all hosts.
#
# Each list item is one instance and sets `host` to scope itself to one
# inventory host. Fully destroying an instance requires both `state: absent`
# and `clean_data: true`; with the default clean_data (false) only the
# container and config are removed, while the data and WAL directories and
# the pgBackRest stanza are kept. Add `replica_of: <name>` for a read-only
# replica;
# primaries are reconciled first and the referenced primary must exist and be
# running before the replica is created. Replica entries accept only name,
# replica_of, replica_of_host, namespace, state, autostart and clean_data;
# password, database, image, extensions and PITR settings are inherited from
# the primary. A same-host replica must use its primary's namespace (the role
# inherits it when the replica omits namespace). Replica names must be lower
# case letters, digits and underscores
# only (the slot is named pgcli_r_<replica>). Add `replica_of_host` when the
# primary runs on another host: the role prepares the primary there (slot +
# pg_hba), then creates the replica with --primary-dsn, reading the primary
# password from that host's pg.yaml.

# ── Scenario selection ─────────────────────────────────────────────────────
# pgcli_instances and pgcli_addons are read from the inventory group named by
# --limit. Deployment-mode and add-on runs are selected this way instead of
# per-mode plays.
#
# Add-ons: --limit addon_<type>_<single|cluster> selects that group's list
# (addon_<kind>_addons) and, for the pg_addon role, the matching
# addon_<kind>_params / addon_<kind>_conf variables. Without such a --limit
# both lists stay empty and the add-on play is a no-op.
#
# Enable one scenario at a time: the single/samehost/crosshost mode groups,
# instance_addon_mixed and ha_etcd also define pgcli_instances / pgcli_addons
# at group level, and group vars override this file for their hosts. Keep them
# disabled in hosts.ini while running add-on groups.
#
# Normally do not edit pgcli_instances / pgcli_addons here: they are derived
# from --limit addon_<type>_<single|cluster> (and stay empty otherwise).
# Scenario groups such as observable define their own lists in
# group_vars/<group>/main.yml.
_addon_limit: "{{ ansible_limit | default('', true) }}"
_addon_group: >-
  {{ _addon_limit
     if (_addon_limit is match('^addon_[A-Za-z0-9_]+$') and _addon_limit in groups)
     else '' }}
_addon_kind: "{{ _addon_group | regex_replace('^addon_', '') }}"
_addon_type: "{{ _addon_kind | regex_replace('_(single|cluster)$', '') }}"
_addon_mode: >-
  {{ 'cluster' if _addon_kind is match('.*_cluster$')
     else ('single' if _addon_kind is match('.*_single$') else '') }}
_addon_limit_is_addon_like: "{{ _addon_limit is match('^addon_') }}"

pgcli_instances: >-
  {{ lookup('vars', 'addon_' ~ _addon_kind ~ '_instances', default=[])
     if _addon_group | length > 0 else [] }}

# Add-ons on this host. The selected group's list is addon_<kind>_addons; every
# entry accepts type, name or instance, state, args, conf, clean_data, force
# and autostart.
#
# Per-type parameters are declared next to that list in group_vars/all or in
# the add-on's own group file as addon_<kind>_params, a list of raw
# `pg addon install` flags; the role uses it for every entry of that type
# without its own params:
#
#   addon_redis_single_params:
#     - "--data-dir=/data/pg/addon/redis/redis1"
#     - "--aof"
#
# For nginx, haproxy, privoxy, prometheus and alertmanager, addon_<kind>_conf
# holds the full config file content. The role writes it under
# <config dir>/addons/ and passes --conf-file; a per-entry `conf` overrides the
# group-level variable.
pgcli_addons: >-
  {{ lookup('vars', 'addon_' ~ _addon_kind ~ '_addons', default=[])
     if _addon_group | length > 0 else [] }}

# Host processes managed by `pg daemon` (not containers), reconciled by the
# pg_daemon role before add-ons. Entries without `host` run on every host in
# the play; `host: <inventory hostname>` scopes one entry to a single host.
# Each entry accepts:
#   name, host, state (started|stopped|absent), autostart,
#   dir (default: the deployment home), log_file (relative paths resolve
#   under dir; empty keeps the pgcli default), log_max_size (for example 10M),
#   log_rotate_daily (bool), log_keep (default 7),
#   files (flat filename -> content, written under dir with mode 0640),
#   command (argv; command[0] must be an absolute path).
# The daemon runs as the deployment account, so its pg.yaml and home are the
# same ones used for instances and add-ons.
#
# Example: a loopback webhook receiver on one host.
#
# pgcli_daemons:
#   - name: alertmanager-webhook
#     host: debian12-04
#     state: started
#     autostart: true
#     dir: "{{ pgcli_deploy_home }}/alertmanager-webhook"
#     log_file: logs/webhook.log
#     log_max_size: 10M
#     log_keep: 7
#     files:
#       webhook.py: "{{ lookup('file', playbook_dir ~ '/../misc/webhook/webhook.py') }}"
#     command:
#       - /usr/bin/python3
#       - "{{ pgcli_deploy_home }}/alertmanager-webhook/webhook.py"
#       - "--listen"
#       - "127.0.0.1:18801"
pgcli_daemons: []
