---
# Example group configuration. Copy to main.yml and edit for the real
# environment; group_vars/*/main.yml is gitignored.
#
# Shared defaults for every pgcli host.
# Deployment-mode groups (single, samehost, crosshost) override the defaults
# in their own group_vars and each define their own pgcli_instances; the role
# marker groups (ha_etcd for the DCS, ha_cluster for Patroni members) do the
# same for the HA stack. Mode groups take precedence over the role marker
# groups (ansible_group_priority).

# Installation goes through scripts/install.sh (GitHub release, not a local
# build). The installer only runs when pg is missing or force is true.
# Use an https:// URL to download it on the target host, or a controller path
# to copy it from a local checkout (for offline or air-gapped setups).
pgcli_install_script_src: "https://raw.githubusercontent.com/mars-base/pgcli/main/scripts/install.sh"
pgcli_install_script_path: /tmp/pgcli-install.sh
pgcli_install_version: ""       # release tag, e.g. v1.2.3; empty = latest
pgcli_install_skip_pull: false  # pass --skip-pull: do not pre-pull images
pgcli_install_force: false      # re-run the installer even if pg exists

# Offline binary: URL of a raw pg binary or a release tarball
# (pgcli_<version>_linux_amd64.tar.gz). When set, pg is installed from that
# artifact and scripts/install.sh runs with --skip-binary (host
# initialization still happens: uidmap, /etc/containers/policy.json,
# userns check, SELinux).
# Empty = install via scripts/install.sh (GitHub releases).
pgcli_install_binary_url: ""

# Offline podman launcher: URL of the podman-launcher binary
# (https://github.com/89luca89/podman-launcher). When set and no podman
# exists on the host, the launcher is fetched from that URL; the launcher
# then downloads the static podman tree on first use.
# Empty = the launcher comes from GitHub releases via install.sh.
pgcli_podman_binary_url: ""

# Offline mirror for host-side downloads: juicefs/zerofs/duckdb binaries and
# the DocumentDB DEBs. When set, pgcli fetches each external release asset
# from <mirror>/<basename> instead of GitHub or archive.ubuntu.com. This is the
# same static server used for container images.
# pgcli_download_mirror: "http://192.0.2.10:18080"
pgcli_download_mirror: ""

# ── Offline container images ────────────────────────────────────────────────
# The image tarballs are large, so hosts can load them from a LAN static HTTP
# server instead of pulling from public registries.
#
# Leave empty for the online path: scripts/install.sh pulls the core images.
# Set it to the server root that contains the `podman save` tarballs produced
# by `make container-images-export`, for example:
#
#   pgcli_images_http_url: "http://192.0.2.10:18080"
#
# and serve that directory with:
#
#   pg http start --listen 0.0.0.0 --port 18080 --dir images
#
# When set, the installer runs with --skip-pull, and every image missing from
# podman's local store is fetched from <url>/<archive> and loaded with
# `podman load`. The playbook first sends HEAD requests to the server root and
# to every enabled archive; if any is unreachable or missing it aborts before
# changing anything.
pgcli_images_http_url: ""

# Where downloaded tarballs are cached on the target host. Kept across runs so
# only missing images are transferred again; safe to delete at any time.
pgcli_images_cache_dir: /var/cache/pgcli/images

# true = always re-download and re-load every archive, even when the image
# tag already exists in podman. Use after replacing an archive on the server.
pgcli_images_force_load: false

# Complete image manifest, mirroring IMAGES in the repo Makefile. `archive`
# matches the tar name produced by `make container-images-export`
# (`<repo>_<tag>.tar`). Trim entries that are not needed to reduce transfer
# time; add any custom image tags here as well.
pgcli_images:
  - image: ghcr.io/mars-base/pgcli/pgcli-pg:18-2.58.0
    archive: pgcli-pg_18-2.58.0.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-patroni:18-4.1.5
    archive: pgcli-patroni_18-4.1.5.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-backup:2.58.0
    archive: pgcli-backup_2.58.0.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-minio:20250422221226
    archive: pgcli-minio_20250422221226.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-mc:20250813083541
    archive: pgcli-mc_20250813083541.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-rustfs:1.0.0
    archive: pgcli-rustfs_1.0.0.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-influxdb:1.13.1
    archive: pgcli-influxdb_1.13.1.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-influx2tsdb:1.3.2
    archive: pgcli-influx2tsdb_1.3.2.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-documentdb-gateway:1.0.0
    archive: pgcli-documentdb-gateway_1.0.0.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-mongosh:2.14.1
    archive: pgcli-mongosh_2.14.1.tar
  - image: ghcr.io/mars-base/pgcli/predixy:7.0.1-alpine
    archive: predixy_7.0.1-alpine.tar
  - image: docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z
    archive: silo_RELEASE.2026-09-16T00-00-00Z.tar
  - image: docker.io/postgrest/postgrest:v16.3
    archive: postgrest_v16.3.tar
  - image: docker.io/edoburu/pgbouncer:v1.25.2-p0
    archive: pgbouncer_v1.25.2-p0.tar
  - image: docker.io/library/haproxy:3.2.23-alpine
    archive: haproxy_3.2.23-alpine.tar
  - image: quay.io/coreos/etcd:v3.5.30
    archive: etcd_v3.5.30.tar
  - image: ghcr.io/pgdogdev/pgdog:v0.1.57
    archive: pgdog_v0.1.57.tar
  - image: docker.io/library/redis:7.4.11
    archive: redis_7.4.11.tar
  - image: docker.io/library/redis:8.10.2
    archive: redis_8.10.2.tar
  - image: docker.io/dpage/pgadmin4:9.18
    archive: pgadmin4_9.18.tar
  - image: docker.io/library/nginx:1.27-alpine
    archive: nginx_1.27-alpine.tar
  - image: docker.io/dxflrs/garage:v2.4.1
    archive: garage_v2.4.1.tar
  - image: docker.io/chrislusf/seaweedfs:4.48_large_disk
    archive: seaweedfs_4.48_large_disk.tar
  - image: docker.io/grafana/grafana:13.2.4
    archive: grafana_13.2.4.tar
  - image: docker.io/prom/prometheus:v3.15.0
    archive: prometheus_v3.15.0.tar
  - image: docker.io/prom/alertmanager:v0.34.1
    archive: alertmanager_v0.34.1.tar
  - image: docker.io/gitea/gitea:28.1.0
    archive: gitea_28.1.0.tar
  - image: ghcr.io/thinkparq/beegfs-mgmtd:8.4.0
    archive: beegfs-mgmtd_8.4.0.tar
  - image: ghcr.io/thinkparq/beegfs-meta:8.4.0
    archive: beegfs-meta_8.4.0.tar
  - image: ghcr.io/thinkparq/beegfs-storage:8.4.0
    archive: beegfs-storage_8.4.0.tar
  - image: docker.io/victoriametrics/victoria-metrics:v1.154.1
    archive: victoria-metrics_v1.154.1.tar
  - image: docker.io/victoriametrics/vminsert:v1.154.1-cluster
    archive: vminsert_v1.154.1-cluster.tar
  - image: docker.io/victoriametrics/vmselect:v1.154.1-cluster
    archive: vmselect_v1.154.1-cluster.tar
  - image: docker.io/victoriametrics/vmstorage:v1.154.1-cluster
    archive: vmstorage_v1.154.1-cluster.tar
  - image: docker.io/victoriametrics/victoria-logs:v1.53.0
    archive: victoria-logs_v1.53.0.tar
  - image: docker.io/victoriametrics/vlagent:v1.53.0
    archive: vlagent_v1.53.0.tar
  - image: docker.io/victoriametrics/vmalert:v1.133.0
    archive: vmalert_v1.133.0.tar
  - image: docker.io/clickhouse/clickhouse-server:26.8.36.3
    archive: clickhouse-server_26.8.36.3.tar
  - image: docker.io/apache/kafka:4.4.0
    archive: kafka_4.4.0.tar
  - image: docker.io/library/rabbitmq:4.4.0-management
    archive: rabbitmq_4.4.0-management.tar
  - image: docker.io/apache/rocketmq:5.5.0
    archive: rocketmq_5.5.0.tar
  - image: docker.io/prom/node-exporter:v1.12.1
    archive: node-exporter_v1.12.1.tar
  - image: docker.io/pgsty/pg_exporter:1.5.0
    archive: pg_exporter_1.5.0.tar

pgcli_install_path: /usr/local/bin/pg

# Optional: directory that stores this host's namespace pg.yaml. When
# non-empty every pgcli command runs with `-c <pgcli_namespace_path>/pg.yaml`
# (created with `pg config init -o`), so all instances declared in
# pgcli_instances are created inside that namespace. Leave it empty to use
# pgcli_config_path.
# pgcli_namespace_path: /root/.pgcli/dev
pgcli_namespace_path: ""
pgcli_config_path: >-
  {{ (pgcli_namespace_path | regex_replace('/+$', '') ~ '/pg.yaml')
     if pgcli_namespace_path | default('', true) | length > 0
     else '/root/.pgcli/pg.yaml' }}

# Named namespaces shared by every host. Each entry maps a selector name to the
# directory that stores its pg.yaml. An instance picks one with
# `namespace: <name>` in pgcli_instances; instances without it use
# pgcli_namespace_path / pgcli_config_path. Add more entries as needed.
# Lookups are by name, never by list position. The entry whose path resolves to
# pgcli_config_path represents the host-default config: the pgcli role's main
# init task creates it from pgcli_config_overrides.namespace, and the
# extra-namespace loop skips it by path.
#
# An extra entry whose path differs from pgcli_config_path is initialized
# automatically when it also declares `base_dir`. Optional init fields:
#   base_dir, backup_dir, pg_start_port, pg_ssh_port
# Missing fields fall back to pgcli_config; a missing backup_dir lets
# `pg config init` default to <base_dir>/backup. Entries without base_dir keep
# the manual `pg config init -o <path>/pg.yaml` workflow.
pgcli_namespaces:
  - name: default
    path: /root/.pgcli

# Consumed by `pg config init` on the first run only. Editing these later
# does NOT rewrite an existing pg.yaml.
pgcli_config_defaults:
  namespace: default
  base_dir: /data/pg
  backup_dir: /mnt/backup/pg
  pg_start_port: 35432
  pg_ssh_port: 42201

pgcli_config_overrides: {}
pgcli_config: "{{ pgcli_config_defaults | combine(pgcli_config_overrides) }}"

# Per-instance attribute defaults. This is ONE template applied to ONE
# instance at a time, not a list of instances. For every entry in
# pgcli_instances the role computes (shallow merge):
#
#   spec = pgcli_instance_defaults | combine(entry)
#
# Keys set on an entry override the defaults below; missing keys fall back to
# them. `name` cannot be defaulted and must be set on each entry.
#
# state:           present | started | stopped | absent
#                  present = create the instance but leave its run state alone
# namespace:       name from pgcli_namespaces; the instance is created in that
#                  namespace's pg.yaml (-c <path>/pg.yaml). Omit for the host
#                  default (pgcli_namespace_path / pgcli_config_path)
# autostart:       enable the instance at boot (`pg autostart enable`)
# backup_target:   local | s3; fixed at creation time, later changes only warn
# password_length: generated admin password length used by `pg create`
# extensions:      PostgreSQL extensions to install; an entry that sets this
#                  list replaces the default list entirely (no append)
# clean_data:      only used with state absent; true also deletes the data and
#                  WAL directories and the pgBackRest stanza. Default false
#                  keeps the host data so a later create reuses it. Fully
#                  destroying an instance needs both state: absent and
#                  clean_data: true; clean_data alone does nothing.
pgcli_instance_defaults:
  state: started
  autostart: false
  backup_target: local
  password_length: 16
  extensions: []
  clean_data: false

# Desired instances are consumed by the pg_instance role. Each deployment-mode
# group defines pgcli_instances in its own group_vars/<mode>/main.yml and is
# responsible only for that mode. Enable one mode group at a time in the
# inventory; apply.yaml runs a single generic instance play over all hosts.
#
# Each list item is one instance and sets `host` to scope itself to one
# inventory host. Fully destroying an instance requires both `state: absent`
# and `clean_data: true`; with the default clean_data (false) only the
# container and config are removed, while the data and WAL directories and
# the pgBackRest stanza are kept. Add `replica_of: <name>` for a read-only
# replica;
# primaries are reconciled first and the referenced primary must exist and be
# running before the replica is created. Replica entries accept only name,
# replica_of, replica_of_host, namespace, state, autostart and clean_data;
# password, database, image, extensions and PITR settings are inherited from
# the primary. A same-host replica must use its primary's namespace (the role
# inherits it when the replica omits namespace). Replica names must be lower
# case letters, digits and underscores
# only (the slot is named pgcli_r_<replica>). Add `replica_of_host` when the
# primary runs on another host: the role prepares the primary there (slot +
# pg_hba), then creates the replica with --primary-dsn, reading the primary
# password from that host's pg.yaml.

# Empty default; each deployment-mode group overrides it with its own list in
# group_vars/<mode>/main.yml. Enable one mode group at a time so every
# selected host reconciles that group's list.
pgcli_instances: []

# Add-ons on this host, consumed by the pg_addon role. Every entry accepts
# type, name or instance, state, args, conf, clean_data, force and autostart;
# autostart defaults to true and clean_data defaults to true with state absent.
#
# Per-type parameters are declared once in the add-on's group as a list of raw
# `pg addon install` flags; the role appends them to every entry of that type:
#
#   addon_redis_params:
#     - "--data-dir=/data/pg/addon/redis/redis1"
#     - "--aof"
#
# For nginx, haproxy, prometheus and alertmanager, addon_<type>_conf holds the
# full config file content. The role writes it under <config dir>/addons/ and
# passes --conf-file; a per-entry `conf` overrides the group-level variable.
pgcli_addons: []
