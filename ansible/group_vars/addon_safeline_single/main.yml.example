---
# safeline standalone add-on group (addon_safeline_single).
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_safeline_single --tags addon
#
# SafeLine WAF runs a seven-container stack per instance (bundled PostgreSQL,
# console, detector, tengine traffic proxy, luigi, fvm, chaos) on a dedicated
# bridge network with fixed container addresses. It needs Linux and rootful
# podman. The console listens on HTTPS (self-signed certificate) and publishes
# one host port; the protected sites' traffic ports (default 80/443) are
# configured per site in the console.
#
# The play runs the safeline commands as root (rootful podman) even on a host
# configured for rootless deployment (for example a host that also belongs to
# an active scenario group) and prints a notice; the stack stays in the
# deployment account's pgcli config.

# Default flags for safeline entries that do not set their own params.
addon_safeline_single_params: []
# Example:
#   - "--data-dir=/data/pg/addon/safeline/safeline1"
#   - "--port=9443"                 # console HTTPS host port
#   - "--listen=0.0.0.0"
#   - "--subnet-prefix=172.22.222"  # each stack needs its own /24
#   - "--version=9.4.7"             # SafeLine release tag
#   - "--postgres-version=15.18"    # bundled PostgreSQL tag

addon_safeline_single_addons:
  - type: safeline
    state: present
    name: safeline1
    # Reload tengine on every playbook run: re-resolves the protected sites'
    # upstream host names (nginx -t + graceful reload, the stack keeps serving).
    # autoreload: true
    # Protected sites (optional). Each apply creates the missing ones — the
    # PEM files below are controller paths, uploaded with the site — and
    # updates the upstream of existing ones when it changed. Removing an
    # entry here does NOT delete the site from the console; renewing a
    # certificate stays manual (`pg addon safeline cert update`).
    # sites:
    #   - domains: [www.example.com]        # default ["*"] (any Host header)
    #     ports: ["443_ssl", "80"]          # suffix a port _ssl to terminate TLS
    #     upstream: http://10.0.0.5:8080    # exactly one upstream (CE edition)
    #     cert: /path/to/fullchain.pem      # optional; with key
    #     key: /path/to/privkey.pem
    #     health_check: true                # optional
    #     health_check_interval: 10         # seconds, 10-3600
    #     health_check_path: /
    #     comment: "example"
    #     # Optional protections, applied on every playbook run (the commands
    #     # are idempotent server-side and reported as changed):
    #     cc:
    #       waiting_room:                     # CC 防护: the waiting room
    #         enabled: true
    #         max_concurrent: 500             # 1-5000; Pro only, the CE keeps 5
    #         session_timeout: 10             # minutes, 1-30; Pro only, the CE keeps 3
    #       rate_limit:                       # CC 防护: rate-limit rules
    #         use_global: false               # true = follow the shared rules again
    #         rules:                          # a site following the global set
    #                                         # switches to its own copy (all
    #                                         # rules disabled) first; a rule is
    #                                         # enabled unless it says enabled: false
    #           - type: req                   # req, attack or error (required)
    #             enabled: true
    #             period: 10                  # seconds, 10-600
    #             count: 200                  # requests per window
    #             action: block               # block, challenge_v1, challenge_v2
    #             block_min: 30               # minutes, 1-1440
    #     protect:                            # 攻击防护 (semantic analysis)
    #       mode: balance                     # disable, observe, balance or strict;
    #                                         # sets all 14 modules in one call
    #       # use_global: true                # follow the global levels again
    #     bot:                                # BOT 防护 (invisible 人机验证)
    #       enabled: true
    #       # exactly one of all_visitors / where while enabled:
    #       # all_visitors: true              # challenge every visitor
    #       where:                            # challenge matching visitors only;
    #                                         # replaces the stored conditions
    #         - "uri:prefix=/admin && method:eq=POST"
    #         - "req_header/User-Agent:has=curl"
