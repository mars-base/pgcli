---
# EXAMPLE ONLY: copy to main.yml (gitignored) and adjust.
# Secrets and host-specific values are placeholders.
# Cluster add-on test group. Select one type at runtime:
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_cluster \
#     --tags addon -e addon_type=etcd
#
# Every add-on owns its variables under its own section below; the derived
# topology expressions used by that add-on live there too. Each section names
# the inventory group it targets with _addon_cluster_<type>_group and derives
# its host list from it, so a different group can be used per add-on. Each
# entry's state field directly controls the lifecycle: present installs or
# keeps the member, absent removes it (and its data, unless the entry sets
# clean_data: false). Passwords and the shared CA/server certificate are
# generated once on the controller by roles/addon_cluster_shared and loaded
# into the empty defaults via set_fact before pg_addon runs.

# Runtime selector: -e addon_type=<type> picks that add-on's list. This is
# playbook plumbing, not add-on configuration; every add-on's settings live in
# its own ===== section below.
_addon_kind: "{{ addon_type | default('') | replace('-', '_') }}"
pgcli_addons: "{{ lookup('vars', 'addon_' ~ _addon_kind ~ '_addons', default=[]) }}"


# ===== etcd =====
# 3-member etcd DCS. The first host bootstraps, the others join it; the
# serial:1 add-on play guarantees the bootstrap member is ready first.
_addon_cluster_etcd_group: addon_cluster
_addon_cluster_etcd_hosts: "{{ groups[_addon_cluster_etcd_group] }}"
_addon_cluster_etcd_index: "{{ _addon_cluster_etcd_hosts.index(inventory_hostname) | int }}"
_addon_cluster_etcd_ip: "{{ hostvars[inventory_hostname]['private_ip'] }}"
_addon_cluster_etcd_first_ip: "{{ hostvars[_addon_cluster_etcd_hosts[0]]['private_ip'] }}"
_addon_cluster_etcd_join_args: >-
  {{ [] if (_addon_cluster_etcd_index | int) == 0
     else ['--join', 'http://' ~ _addon_cluster_etcd_first_ip ~ ':2379'] }}

addon_etcd_addons:
  - type: etcd
    state: "{{ 'present' if inventory_hostname in _addon_cluster_etcd_hosts[:3] else 'absent' }}"
    name: "etcd-{{ (_addon_cluster_etcd_index | int) + 1 }}"
    params:
      - "--cluster"
      - "pgcli-cluster"
      - "--advertise-host"
      - "{{ _addon_cluster_etcd_ip }}"
      - "--client-port"
      - "2379"
      - "--peer-port"
      - "2380"
      - "--data-dir"
      - "/data/pg/addon/etcd/cluster"
    args: "{{ _addon_cluster_etcd_join_args }}"


# ===== minio =====
# 4-node MNSD (minimum four endpoints). Each node advertises its own /data.
# The root password is generated on the controller; set *_tls to true to use
# the shared certificate (all endpoints then switch to https://).
_addon_cluster_minio_group: addon_cluster
_addon_cluster_minio_hosts: "{{ groups[_addon_cluster_minio_group] }}"
_addon_cluster_minio_root_user: admin
_addon_cluster_minio_root_password: ""
_addon_cluster_minio_tls: false
_addon_cluster_minio_tls_cert: "{{ addon_cluster_shared_server_chain_cert }}"
_addon_cluster_minio_tls_key: "{{ addon_cluster_shared_server_key }}"
_addon_cluster_minio_scheme: "{{ 'https' if _addon_cluster_minio_tls else 'http' }}"
_addon_cluster_minio_tls_args: >-
  {{ ['--tls-cert', _addon_cluster_minio_tls_cert,
      '--tls-key', _addon_cluster_minio_tls_key]
     if _addon_cluster_minio_tls else [] }}
_addon_cluster_minio_endpoint_args: >-
  {%- set out = [] -%}
  {%- for host in _addon_cluster_minio_hosts -%}
  {%- set _ = out.extend(['--endpoint', _addon_cluster_minio_scheme ~ '://' ~ hostvars[host].private_ip ~ ':9100/data']) -%}
  {%- endfor -%}
  {{ out }}

addon_minio_addons:
  - type: minio
    state: present
    name: minio-cluster
    params:
      - "--listen"
      - "0.0.0.0"
      - "--api-port"
      - "9100"
      - "--console-port"
      - "9101"
      - "--root-user"
      - "{{ _addon_cluster_minio_root_user }}"
      - "--root-password"
      - "{{ _addon_cluster_minio_root_password }}"
      - "--data-dir"
      - "/data/pg/addon/minio/cluster"
    args: "{{ _addon_cluster_minio_endpoint_args + _addon_cluster_minio_tls_args }}"


# ===== silo =====
# Same 4-node MNSD layout on a separate port pair.
_addon_cluster_silo_group: addon_cluster
_addon_cluster_silo_hosts: "{{ groups[_addon_cluster_silo_group] }}"
_addon_cluster_silo_root_user: admin
_addon_cluster_silo_root_password: ""
_addon_cluster_silo_tls: false
_addon_cluster_silo_tls_cert: "{{ addon_cluster_shared_server_chain_cert }}"
_addon_cluster_silo_tls_key: "{{ addon_cluster_shared_server_key }}"
_addon_cluster_silo_scheme: "{{ 'https' if _addon_cluster_silo_tls else 'http' }}"
_addon_cluster_silo_tls_args: >-
  {{ ['--tls-cert', _addon_cluster_silo_tls_cert,
      '--tls-key', _addon_cluster_silo_tls_key]
     if _addon_cluster_silo_tls else [] }}
_addon_cluster_silo_endpoint_args: >-
  {%- set out = [] -%}
  {%- for host in _addon_cluster_silo_hosts -%}
  {%- set _ = out.extend(['--endpoint', _addon_cluster_silo_scheme ~ '://' ~ hostvars[host].private_ip ~ ':9200/data']) -%}
  {%- endfor -%}
  {{ out }}

addon_silo_addons:
  - type: silo
    state: present
    name: silo-cluster
    params:
      - "--listen"
      - "0.0.0.0"
      - "--api-port"
      - "9200"
      - "--console-port"
      - "9201"
      - "--root-user"
      - "{{ _addon_cluster_silo_root_user }}"
      - "--root-password"
      - "{{ _addon_cluster_silo_root_password }}"
      - "--data-dir"
      - "/data/pg/addon/silo/cluster"
    args: "{{ _addon_cluster_silo_endpoint_args + _addon_cluster_silo_tls_args }}"


# ===== rustfs =====
# 4-node MNMD; each node contributes one drive, so no extra VM disks are
# needed (/data is a separate block device).
_addon_cluster_rustfs_group: addon_cluster
_addon_cluster_rustfs_hosts: "{{ groups[_addon_cluster_rustfs_group] }}"
_addon_cluster_rustfs_root_user: admin
_addon_cluster_rustfs_root_password: ""
_addon_cluster_rustfs_tls: false
_addon_cluster_rustfs_tls_cert: "{{ addon_cluster_shared_server_chain_cert }}"
_addon_cluster_rustfs_tls_key: "{{ addon_cluster_shared_server_key }}"
_addon_cluster_rustfs_scheme: "{{ 'https' if _addon_cluster_rustfs_tls else 'http' }}"
_addon_cluster_rustfs_tls_args: >-
  {{ ['--tls-cert', _addon_cluster_rustfs_tls_cert,
      '--tls-key', _addon_cluster_rustfs_tls_key]
     if _addon_cluster_rustfs_tls else [] }}
_addon_cluster_rustfs_endpoint_args: >-
  {%- set out = [] -%}
  {%- for host in _addon_cluster_rustfs_hosts -%}
  {%- set _ = out.extend(['--endpoint', _addon_cluster_rustfs_scheme ~ '://' ~ hostvars[host].private_ip ~ ':9300']) -%}
  {%- endfor -%}
  {{ out }}

addon_rustfs_addons:
  - type: rustfs
    state: present
    name: rustfs-cluster
    params:
      - "--listen"
      - "0.0.0.0"
      - "--api-port"
      - "9300"
      - "--console-port"
      - "9301"
      - "--root-user"
      - "{{ _addon_cluster_rustfs_root_user }}"
      - "--root-password"
      - "{{ _addon_cluster_rustfs_root_password }}"
      - "--drive"
      - "/data/pg/addon/rustfs/cluster/d1"
    args: "{{ _addon_cluster_rustfs_endpoint_args + _addon_cluster_rustfs_tls_args }}"


# ===== seaweedfs =====
# 3 members with one shared PostgreSQL filer-metadata database. weed requires
# an odd number of masters, so the fourth host stays absent.
_addon_cluster_seaweedfs_group: addon_cluster
_addon_cluster_seaweedfs_hosts: "{{ groups[_addon_cluster_seaweedfs_group] }}"
_addon_cluster_seaweedfs_members: "{{ _addon_cluster_seaweedfs_hosts[:3] }}"
_addon_cluster_seaweedfs_ip: "{{ hostvars[inventory_hostname]['private_ip'] }}"
_addon_cluster_seaweedfs_root_user: SWaddoncluster
_addon_cluster_seaweedfs_root_password: ""
# Cluster mode needs one PostgreSQL metadata database reachable from every
# member. Pre-create the database, then point this at it.
_addon_cluster_seaweedfs_meta_dsn: "postgres://admin:<pg-password>@192.0.2.10:35432/seaweed_store"
_addon_cluster_seaweedfs_tls: false
_addon_cluster_seaweedfs_tls_cert: "{{ addon_cluster_shared_server_chain_cert }}"
_addon_cluster_seaweedfs_tls_key: "{{ addon_cluster_shared_server_key }}"
_addon_cluster_seaweedfs_tls_args: >-
  {{ ['--tls-cert', _addon_cluster_seaweedfs_tls_cert,
      '--tls-key', _addon_cluster_seaweedfs_tls_key]
     if _addon_cluster_seaweedfs_tls else [] }}
_addon_cluster_seaweedfs_peer_args: >-
  {%- set out = [] -%}
  {%- for host in _addon_cluster_seaweedfs_members -%}
  {%- set _ = out.extend(['--peer', hostvars[host].private_ip ~ ':8400']) -%}
  {%- endfor -%}
  {{ out }}

addon_seaweedfs_addons:
  - type: seaweedfs
    state: "{{ 'present' if inventory_hostname in _addon_cluster_seaweedfs_members else 'absent' }}"
    name: seaweedfs-cluster
    params:
      - "--cluster"
      - "pgcli-cluster"
      - "--advertise-host"
      - "{{ _addon_cluster_seaweedfs_ip }}"
      - "--replication"
      - "001"
      - "--root-user"
      - "{{ _addon_cluster_seaweedfs_root_user }}"
      - "--root-password"
      - "{{ _addon_cluster_seaweedfs_root_password }}"
      - "--dsn"
      - "{{ _addon_cluster_seaweedfs_meta_dsn }}"
      - "--listen"
      - "0.0.0.0"
      - "--data-dir"
      - "/data/pg/addon/seaweedfs/cluster"
    args: "{{ _addon_cluster_seaweedfs_peer_args + _addon_cluster_seaweedfs_tls_args }}"


# ===== redis =====
# 4 cluster-enabled members. pgcli only installs them; assemble the slots with
# `pg redis-cli` after every member is up (see the docs page).
_addon_cluster_redis_group: addon_cluster
_addon_cluster_redis_ip: "{{ hostvars[inventory_hostname]['private_ip'] }}"
_addon_cluster_redis_password: ""

addon_redis_addons:
  - type: redis
    state: present
    name: redis-cluster
    params:
      - "--cluster"
      - "pgcli-cluster"
      - "--advertise-host"
      - "{{ _addon_cluster_redis_ip }}"
      - "--port"
      - "6379"
      - "--password"
      - "{{ _addon_cluster_redis_password }}"
      - "--listen"
      - "0.0.0.0"
      - "--data-dir"
      - "/data/pg/addon/redis/cluster"


# ===== clickhouse-keeper =====
# 3-member Raft quorum. The fourth host stays absent.
_addon_cluster_clickhouse_keeper_group: addon_cluster
_addon_cluster_clickhouse_keeper_hosts: "{{ groups[_addon_cluster_clickhouse_keeper_group] }}"
_addon_cluster_clickhouse_keeper_index: "{{ _addon_cluster_clickhouse_keeper_hosts.index(inventory_hostname) | int }}"
_addon_cluster_clickhouse_keeper_ip: "{{ hostvars[inventory_hostname]['private_ip'] }}"
_addon_cluster_clickhouse_keeper_peer_args: >-
  {%- set out = [] -%}
  {%- set three = _addon_cluster_clickhouse_keeper_hosts[:3] -%}
  {%- for host in three -%}
  {%- if host != inventory_hostname -%}
  {%- set _ = out.extend(['--peer', (((three.index(host) + 1) | string) ~ '@' ~ hostvars[host].private_ip)]) -%}
  {%- endif -%}
  {%- endfor -%}
  {{ out }}

addon_clickhouse_keeper_addons:
  - type: clickhouse-keeper
    state: "{{ 'present' if inventory_hostname in _addon_cluster_clickhouse_keeper_hosts[:3] else 'absent' }}"
    name: keeper-cluster
    params:
      - "--server-id"
      - "{{ (_addon_cluster_clickhouse_keeper_index | int) + 1 }}"
      - "--advertise-host"
      - "{{ _addon_cluster_clickhouse_keeper_ip }}"
      - "--listen"
      - "0.0.0.0"
      - "--client-port"
      - "9181"
      - "--raft-port"
      - "9234"
      - "--data-dir"
      - "/data/pg/addon/clickhouse-keeper/cluster"
    args: "{{ _addon_cluster_clickhouse_keeper_peer_args }}"


# ===== clickhouse =====
# 4 members: 2 shards x 2 replicas, using the 3-member Keeper above.
# ClickHouse TLS is terminated by a fronting proxy, not by this cluster.
_addon_cluster_clickhouse_group: addon_cluster
_addon_cluster_clickhouse_hosts: "{{ groups[_addon_cluster_clickhouse_group] }}"
_addon_cluster_clickhouse_index: "{{ _addon_cluster_clickhouse_hosts.index(inventory_hostname) | int }}"
_addon_cluster_clickhouse_ip: "{{ hostvars[inventory_hostname]['private_ip'] }}"
_addon_cluster_ch_shard: "{{ (((_addon_cluster_clickhouse_index | int) / 2) | int) + 1 }}"
_addon_cluster_ch_replica: "{{ ((_addon_cluster_clickhouse_index | int) % 2) + 1 }}"
_addon_cluster_clickhouse_peer_args: >-
  {%- set out = [] -%}
  {%- for host in _addon_cluster_clickhouse_hosts -%}
  {%- if host != inventory_hostname -%}
  {%- set i = _addon_cluster_clickhouse_hosts.index(host) | int -%}
  {%- set shard = ((i / 2) | int) + 1 -%}
  {%- set replica = (i % 2) + 1 -%}
  {%- set _ = out.extend(['--peer', ((shard | string) ~ '/' ~ (replica | string) ~ '@' ~ hostvars[host].private_ip ~ ':9000')]) -%}
  {%- endif -%}
  {%- endfor -%}
  {{ out }}
_addon_cluster_clickhouse_keeper_endpoint_args: >-
  {%- set out = [] -%}
  {%- for host in _addon_cluster_clickhouse_hosts[:3] -%}
  {%- set _ = out.extend(['--keeper', hostvars[host].private_ip ~ ':9181']) -%}
  {%- endfor -%}
  {{ out }}
_addon_cluster_clickhouse_admin_password: ""

addon_clickhouse_addons:
  - type: clickhouse
    state: present
    name: clickhouse-cluster
    params:
      - "--cluster"
      - "pgcli-chcluster"
      - "--shard"
      - "{{ _addon_cluster_ch_shard }}"
      - "--replica"
      - "{{ _addon_cluster_ch_replica }}"
      - "--advertise-host"
      - "{{ _addon_cluster_clickhouse_ip }}"
      - "--listen"
      - "0.0.0.0"
      - "--interserver-port"
      - "9009"
      - "--admin-password"
      - "{{ _addon_cluster_clickhouse_admin_password }}"
      - "--data-dir"
      - "/data/pg/addon/clickhouse/cluster"
    args: "{{ _addon_cluster_clickhouse_peer_args + _addon_cluster_clickhouse_keeper_endpoint_args }}"


# ===== kafka =====
# 3-node KRaft quorum, 512 MiB heap to fit the 2 GiB VMs. TLS is additive:
# --tls-pem installs the shared combined PEM as an extra SSL listener while
# controller and inter-broker traffic stay plaintext.
_addon_cluster_kafka_group: addon_cluster
_addon_cluster_kafka_hosts: "{{ groups[_addon_cluster_kafka_group] }}"
_addon_cluster_kafka_index: "{{ _addon_cluster_kafka_hosts.index(inventory_hostname) | int }}"
_addon_cluster_kafka_ip: "{{ hostvars[inventory_hostname]['private_ip'] }}"
_addon_cluster_kafka_peer_args: >-
  {%- set out = [] -%}
  {%- set three = _addon_cluster_kafka_hosts[:3] -%}
  {%- for host in three -%}
  {%- if host != inventory_hostname -%}
  {%- set _ = out.extend(['--peer', (((three.index(host) + 1) | string) ~ '@' ~ hostvars[host].private_ip ~ ':19093')]) -%}
  {%- endif -%}
  {%- endfor -%}
  {{ out }}
_addon_cluster_kafka_tls: false
_addon_cluster_kafka_tls_pem: "{{ addon_cluster_shared_server_pem }}"
_addon_cluster_kafka_tls_args: >-
  {{ ['--tls-pem', _addon_cluster_kafka_tls_pem]
     if _addon_cluster_kafka_tls else [] }}

addon_kafka_addons:
  - type: kafka
    state: "{{ 'present' if inventory_hostname in _addon_cluster_kafka_hosts[:3] else 'absent' }}"
    name: kafka-cluster
    params:
      - "--cluster"
      - "pgcli-kafka"
      - "--node-id"
      - "{{ (_addon_cluster_kafka_index | int) + 1 }}"
      - "--advertise-host"
      - "{{ _addon_cluster_kafka_ip }}"
      - "--listen"
      - "0.0.0.0"
      - "--broker-port"
      - "9092"
      - "--controller-port"
      - "19093"
      - "--heap"
      - "512m"
      - "--data-dir"
      - "/data/pg/addon/kafka/cluster"
    args: "{{ _addon_cluster_kafka_peer_args + _addon_cluster_kafka_tls_args }}"


# ===== rabbitmq =====
# 3 members. Shared cookie and admin password are published to etcd once by
# roles/addon_cluster_shared; every member reads them with --secrets-from-etcd.
# The shared material requires a running 3-member etcd cluster.
_addon_cluster_rabbitmq_group: addon_cluster
_addon_cluster_rabbitmq_hosts: "{{ groups[_addon_cluster_rabbitmq_group] }}"
_addon_cluster_rabbitmq_first_host: "{{ _addon_cluster_rabbitmq_hosts[0] }}"
_addon_cluster_rabbitmq_ip: "{{ hostvars[inventory_hostname]['private_ip'] }}"
_addon_cluster_rabbitmq_cluster_name: pgcli-rabbitmq
_addon_cluster_rabbitmq_etcd_endpoints: >-
  {%- set out = [] -%}
  {%- for host in _addon_cluster_rabbitmq_hosts[:3] -%}
  {%- set _ = out.extend([hostvars[host].private_ip ~ ':2379']) -%}
  {%- endfor -%}
  {{ out | join(',') }}
_addon_cluster_rabbitmq_tls: false
_addon_cluster_rabbitmq_tls_cert: "{{ addon_cluster_shared_server_chain_cert }}"
_addon_cluster_rabbitmq_tls_key: "{{ addon_cluster_shared_server_key }}"
_addon_cluster_rabbitmq_tls_args: >-
  {{ ['--tls-cert', _addon_cluster_rabbitmq_tls_cert,
      '--tls-key', _addon_cluster_rabbitmq_tls_key]
     if _addon_cluster_rabbitmq_tls else [] }}

addon_rabbitmq_addons:
  - type: rabbitmq
    state: "{{ 'present' if inventory_hostname in _addon_cluster_rabbitmq_hosts[:3] else 'absent' }}"
    name: rabbitmq-cluster
    params:
      - "--cluster"
      - "{{ _addon_cluster_rabbitmq_cluster_name }}"
      - "--node-name"
      - "rabbit@{{ _addon_cluster_rabbitmq_ip }}"
      - "--etcd-endpoints"
      - "{{ _addon_cluster_rabbitmq_etcd_endpoints }}"
      - "--secrets-from-etcd"
      - "--listen"
      - "0.0.0.0"
      - "--data-dir"
      - "/data/pg/addon/rabbitmq/cluster"
    args: "{{ _addon_cluster_rabbitmq_tls_args }}"


# ===== rocketmq =====
# 3 controllers / brokers. Reduced heaps keep the 2 GiB VMs usable.
_addon_cluster_rocketmq_group: addon_cluster
_addon_cluster_rocketmq_hosts: "{{ groups[_addon_cluster_rocketmq_group] }}"
_addon_cluster_rocketmq_index: "{{ _addon_cluster_rocketmq_hosts.index(inventory_hostname) | int }}"
_addon_cluster_rocketmq_ip: "{{ hostvars[inventory_hostname]['private_ip'] }}"
_addon_cluster_rocketmq_peer_args: >-
  {%- set out = [] -%}
  {%- set three = _addon_cluster_rocketmq_hosts[:3] -%}
  {%- for host in three -%}
  {%- if host != inventory_hostname -%}
  {%- set _ = out.extend(['--peer', ('n' ~ (three.index(host) | string) ~ '@' ~ hostvars[host].private_ip)]) -%}
  {%- endif -%}
  {%- endfor -%}
  {{ out }}

addon_rocketmq_addons:
  - type: rocketmq
    state: "{{ 'present' if inventory_hostname in _addon_cluster_rocketmq_hosts[:3] else 'absent' }}"
    name: rocketmq-cluster
    params:
      - "--cluster"
      - "pgcli-rocketmq"
      - "--controller-id"
      - "n{{ _addon_cluster_rocketmq_index }}"
      - "--advertise-host"
      - "{{ _addon_cluster_rocketmq_ip }}"
      - "--heap"
      - "384m"
      - "--namesrv-heap"
      - "192m"
      - "--proxy-heap"
      - "192m"
      - "--data-dir"
      - "/data/pg/addon/rocketmq/cluster"
    args: "{{ _addon_cluster_rocketmq_peer_args }}"


# ===== vmcluster =====
# First host runs storage + insert + select; the other three are storage-only.
_addon_cluster_vmcluster_group: addon_cluster
_addon_cluster_vmcluster_hosts: "{{ groups[_addon_cluster_vmcluster_group] }}"
_addon_cluster_vmcluster_index: "{{ _addon_cluster_vmcluster_hosts.index(inventory_hostname) | int }}"
_addon_cluster_vmcluster_storage_args: >-
  {%- set out = [] -%}
  {%- for host in _addon_cluster_vmcluster_hosts -%}
  {%- set _ = out.extend(['--storage-node', hostvars[host].private_ip ~ ':8483:8484']) -%}
  {%- endfor -%}
  {{ out }}

addon_vmcluster_addons:
  - type: vmcluster
    state: present
    name: vmcluster-cluster
    params:
      - "--roles"
      - "{{ 'storage,insert,select' if (_addon_cluster_vmcluster_index | int) == 0 else 'storage' }}"
      - "--listen"
      - "0.0.0.0"
      - "--data-dir"
      - "/data/pg/addon/vmcluster/cluster"
    args: "{{ (_addon_cluster_vmcluster_storage_args + ['--replication-factor', '2']) if (_addon_cluster_vmcluster_index | int) == 0 else [] }}"


# ===== vlcluster =====
# Same storage/access split for VictoriaLogs.
_addon_cluster_vlcluster_group: addon_cluster
_addon_cluster_vlcluster_hosts: "{{ groups[_addon_cluster_vlcluster_group] }}"
_addon_cluster_vlcluster_index: "{{ _addon_cluster_vlcluster_hosts.index(inventory_hostname) | int }}"
_addon_cluster_vlcluster_storage_args: >-
  {%- set out = [] -%}
  {%- for host in _addon_cluster_vlcluster_hosts -%}
  {%- set _ = out.extend(['--storage-node', hostvars[host].private_ip ~ ':9432']) -%}
  {%- endfor -%}
  {{ out }}

addon_vlcluster_addons:
  - type: vlcluster
    state: present
    name: vlcluster-cluster
    params:
      - "--roles"
      - "{{ 'storage,insert,select' if (_addon_cluster_vlcluster_index | int) == 0 else 'storage' }}"
      - "--listen"
      - "0.0.0.0"
      - "--data-dir"
      - "/data/pg/addon/vlcluster/cluster"
    args: "{{ _addon_cluster_vlcluster_storage_args if (_addon_cluster_vlcluster_index | int) == 0 else [] }}"
