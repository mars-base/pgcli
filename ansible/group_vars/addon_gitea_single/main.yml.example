---
# gitea standalone add-on group (addon_gitea_single).
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_gitea_single --tags addon

# Single-node test group for the gitea add-on.

# Default flags for gitea entries that do not set their own params.
addon_gitea_single_params: []
# Example:
#   - "--data-dir=/data/pg/addon/gitea/gitea1"

addon_gitea_single_addons:
  - type: gitea
    state: present
    name: gitea1


