---
# silo standalone add-on group (addon_silo_single).
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_silo_single --tags addon

# Single-node test group for the silo add-on.

# Default flags for silo entries that do not set their own params.
addon_silo_single_params: []
# Example:
#   - "--data-dir=/data/pg/addon/silo/silo1"

addon_silo_single_addons:
  - type: silo
    state: present
    name: silo1


