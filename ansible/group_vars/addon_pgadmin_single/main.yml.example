---
# pgadmin standalone add-on group (addon_pgadmin_single).
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_pgadmin_single --tags addon

# Single-node test group for the pgadmin add-on.

# Default flags for pgadmin entries that do not set their own params.
addon_pgadmin_single_params: []
# Example:
#   - "--data-dir=/data/pg/addon/pgadmin/pgadmin1"
#   - "--email=admin@pgcli.lan"
#   - "--port=5050"
#   - "--listen=127.0.0.1"

addon_pgadmin_single_addons:
  - type: pgadmin
    state: present
    name: pgadmin1


