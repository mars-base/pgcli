---
# Observability scenario: four hosts running a mix of PostgreSQL topologies
# for metrics and log collection.
#
#   uv run ansible-playbook playbooks/apply.yaml --limit observable
#
# The first host runs a stand-alone instance, the second a primary and the
# third its cross-host read-only replica; the fourth is left for the
# observability stack itself.
#
# Observability group vars define pgcli_instances at group level, so keep the
# single/samehost/crosshost/instance_addon_mixed scenario groups disabled.
#
# Rootless deployment: pgcli and podman run as the unprivileged pgcli account.
# All derived paths (home, data, backup, image cache, namespaces) follow
# pgcli_deploy_home automatically.
pgcli_deploy_rootless: true
pgcli_deploy_user: pgcli

pgcli_config_overrides:
  namespace: dev

pgcli_instances:
  # Stand-alone instance, no replica.
  - name: pg01
    host: debian12-01
    state: started
    autostart: true

  # Primary with a cross-host replica on debian12-03.
  - name: pg02
    host: debian12-02
    state: started
    autostart: true

  # Cross-host read-only replica. replica_of_host is the inventory hostname
  # of the primary; omit it for a same-host replica.
  - name: pg_primary_ro1
    host: debian12-03
    replica_of: pg02
    replica_of_host: debian12-02
    state: started
    autostart: true

# Host process managed by `pg daemon` (not a container). The receiver appends
# one JSON line per Alertmanager alert to its daemon log:
#   /home/pgcli/alertmanager-webhook/logs/alertmanager-webhook.log
# It binds loopback only, so keep Alertmanager on the same host. The script
# lives in ansible/misc/webhook/ and documents how to forward each alert to a
# custom third-party API. Change the script content to restart the daemon on
# the next apply; registration is idempotent.
pgcli_daemons:
  - name: alertmanager-webhook
    host: debian12-04
    state: started
    autostart: true
    dir: "{{ pgcli_deploy_home }}/alertmanager-webhook"
    log_file: logs/alertmanager-webhook.log
    log_max_size: 10M
    log_keep: 7
    files:
      alertmanager_webhook.py: "{{ lookup('file', playbook_dir ~ '/../misc/webhook/alertmanager_webhook.py') }}"
    command:
      - /usr/bin/python3
      - "{{ pgcli_deploy_home }}/alertmanager-webhook/alertmanager_webhook.py"
      - "--listen"
      - "127.0.0.1:18801"

# Prometheus scrape targets, derived from the inventory. node_exporter runs on
# every member of the observable group; pg_exporter runs on every host that
# carries a pgcli instance. Private IPs come from the [all] host vars.
_observable_node_exporter_targets: >-
  {{ groups['observable'] | map('extract', hostvars, 'private_ip')
     | map('regex_replace', '$', ':9100') | join(',') }}
_observable_pg_exporter_targets: >-
  {{ pgcli_instances | map(attribute='host') | unique
     | map('extract', hostvars, 'private_ip')
     | map('regex_replace', '$', ':9630') | join(',') }}

# Observability stack. node_exporter runs on every host; pg_exporter runs on the
# three PostgreSQL hosts. Prometheus (scraping both jobs) and Grafana live on
# the fourth host. Prometheus has no web authentication, so it stays on
# loopback; Grafana is the exposed UI.
pgcli_addons:
  - type: nodeexporter
    name: nodeexporter
    state: present

  # Local mode derives the admin DSN and creates the low-privilege monitor
  # role: "pgexporter" by default (override with --monitor-user), granted
  # pg_monitor with CONNECTION LIMIT 5. The password is pinned from the
  # gitignored secrets.yaml so the standby's --dsn entry can use the same
  # credential without a post-install fetch.
  - type: pgexporter
    name: pgexporter
    host: debian12-01
    state: present
    params:
      - "--listen=0.0.0.0"
      - "--pg-name"
      - "pg01"
      - "--monitor-password"
      - "{{ pgexporter_monitor_password }}"

  - type: pgexporter
    name: pgexporter
    host: debian12-02
    state: present
    params:
      - "--listen=0.0.0.0"
      - "--pg-name"
      - "pg02"
      - "--monitor-password"
      - "{{ pgexporter_monitor_password }}"

  # A physical standby cannot execute the monitor-role creation SQL. Streaming
  # replication carries the role created for pg02 to this host, so dial it
  # as-is. Keep the default role name "pgexporter" (avoid changing
  # --monitor-user on the primary): this DSN is pinned to it, and a renamed
  # role would need to be created on the primary and carried here by
  # replication. Put the generated monitor password in the gitignored
  # group_vars/observable/secrets.yaml:
  #   pgexporter_monitor_password: "<output of pg addon password pgexporter>"
  - type: pgexporter
    name: pgexporter
    host: debian12-03
    state: present
    dsn: "postgres://pgexporter:{{ pgexporter_monitor_password }}@127.0.0.1:<host-port>/<database>?sslmode=disable"
    params:
      - "--listen=0.0.0.0"

  # Alertmanager receives alerts from the rules below. It stays on loopback
  # (no auth; its silence API is as sensitive as a notification channel). The
  # pg daemon above is the webhook sink on the same host; Alertmanager uses
  # host networking, so it reaches the receiver over loopback. force recreates
  # the container so a changed receiver URL takes effect.
  - type: alertmanager
    name: alertmanager
    host: debian12-04
    state: present
    force: true
    params:
      - "--listen=127.0.0.1"
      - "--webhook-url"
      - "http://127.0.0.1:18801/alertmanager"

  - type: prometheus
    name: prometheus
    host: debian12-04
    state: present
    # Recreate so changed scrape params are applied to the running add-on.
    force: true
    params:
      - "--listen=127.0.0.1"
      - "--alertmanager-url"
      - "127.0.0.1:9093"
      - "--scrape"
      - "node-exporter={{ _observable_node_exporter_targets }}"
      - "--scrape"
      - "pg={{ _observable_pg_exporter_targets }}"
    # Copied into pgcli's managed rules dir and loaded by the rendered
    # prometheus.yml via rule_files. The mapping value is the source path on
    # the controller; keep rule content in a file so Prometheus's own
    # {{ $labels.* }} templating is never re-rendered by Ansible.
    rule_files:
      postgres.rules.yml: "{{ playbook_dir }}/../misc/prometheus/postgres.rules.yml"

  - type: grafana
    name: grafana
    host: debian12-04
    state: present
    params:
      - "--listen=0.0.0.0"
