---
# Example standalone group configuration. Copy to main.yml and edit for the
# real environment; group_vars/*/main.yml is gitignored.
#
# Standalone host role: one local PostgreSQL instance, no cluster DCS.
pgcli_config_overrides:
  namespace: dev

pgcli_instances:
  - name: "{{ pgcli_instance_name }}"
    state: started
    autostart: true
    extensions:
      - pg_stat_statements
