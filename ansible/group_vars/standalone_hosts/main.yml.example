---
# Example standalone group configuration. Copy to main.yml and edit for the
# real environment; group_vars/*/main.yml is gitignored.
#
# Standalone host role: local PostgreSQL instance(s), optionally with
# same-host read-only replicas; no cluster DCS.
pgcli_config_overrides:
  namespace: dev

pgcli_instances:
  - name: pg01
    state: started
    autostart: true
    extensions:
      - pg_stat_statements

  # Optional same-host read-only replica. The primary above must exist and be
  # running; password, database, image, extensions and PITR settings are
  # inherited. Only name, replica_of, state, autostart (and clean_data when
  # destroying) apply to a replica entry. Replica names must be lower case
  # letters, digits and underscores only (the replication slot is named
  # pgcli_r_<replica>), so pg01_ro1 is valid but pg01-ro1 is not.
  # - name: pg01_ro1
  #   replica_of: pg01
  #   state: started
  #   autostart: true
