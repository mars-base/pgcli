---
# Mixed scenario: one PostgreSQL instance plus add-ons created in the same
# playbook run. Mutually exclusive with single/samehost/crosshost; enable only
# one scenario group at a time in hosts.ini.
#
#   uv run ansible-playbook playbooks/apply.yaml --limit instance_addon_mixed
#
# On hosts that already have pgcli installed, add --tags instance,addon to skip
# the install and unrelated plays; the validation play (tagged always) still
# runs.
#
# `host` must match the bare host name listed in the inventory group. The
# instance play runs before the add-on play, so a local add-on can reference
# an instance created in the same run.
#
# Keep only the images this scenario needs. The pgcli role checks each entry
# and downloads/loads only the missing ones from pgcli_images_http_url; the
# offline pre-check validates exactly this list. pgcli-backup is required
# because pgcli_instance_defaults.backup_target defaults to local.
pgcli_images:
  - image: ghcr.io/mars-base/pgcli/pgcli-pg:18-2.58.0
    archive: pgcli-pg_18-2.58.0.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-backup:2.58.0
    archive: pgcli-backup_2.58.0.tar
  - image: docker.io/edoburu/pgbouncer:v1.25.2-p0
    archive: pgbouncer_v1.25.2-p0.tar

# The host-default config lives in dev, so instances and add-ons without an
# explicit namespace use /root/.pgcli/dev/pg.yaml. Non-default namespaces get
# their own directory layer (config, data and backup) and a disjoint PG port
# range. The run below initializes both: dev through the default config task
# (pgcli_config_overrides) and default through the extra-namespace task, which
# only runs when /root/.pgcli/pg.yaml is missing.
pgcli_namespace_path: /root/.pgcli/dev

pgcli_config_overrides:
  namespace: dev
  base_dir: /data/pg/dev
  backup_dir: /mnt/backup/pg/dev
  pg_start_port: 36432
  pg_ssh_port: 43201

pgcli_namespaces:
  - name: default
    path: /root/.pgcli
    base_dir: /data/pg
    backup_dir: /mnt/backup/pg
    pg_start_port: 35432
    pg_ssh_port: 42201
  - name: dev
    path: /root/.pgcli/dev
    base_dir: /data/pg/dev
    backup_dir: /mnt/backup/pg/dev
    pg_start_port: 36432
    pg_ssh_port: 43201

pgcli_instances:
  - name: pg_single
    host: debian12-01
    state: started
    autostart: true
    # 覆盖 pgcli_instance_defaults.extensions，默认列表不会自动叠加。
    extensions:
      - pg_stat_statements
      - pgcrypto
      - pg_trgm
      - timescaledb          # influx2tsdb 目标所需
      # documentdb 网关的前置扩展（仅 PG 18；安装会重建镜像并重启实例）
      # - documentdb

pgcli_addons:
  # Local pgbouncer pooling pg_single. Put flags on the entry's `params` list;
  # with a scenario --limit the add-on play does not select
  # group_vars/addon_pgbouncer_single/main.yml (only --limit
  # addon_pgbouncer_single does). For per-type defaults, define
  # addon_pgbouncer_params in this file instead.
  - type: pgbouncer
    state: present
    instance: pg_single
    # params 变更不会作用于已安装的容器，force 让每次运行都重新 install。
    force: true
    params:
      - "--max-client-conn=100"
      - "--default-pool-size=20"
      # 其余可选参数（括号内为默认值）：
      # - "--min-pool-size=0"
      # - "--reserve-pool-size=0"
      # - "--reserve-pool-timeout=5"
      # - "--max-db-connections=50"        # 0 = 不限制
      # - "--max-user-connections=0"       # 0 = 不限制
      # - "--server-idle-timeout=600"
      # - "--server-lifetime=3600"
      # - "--server-connect-timeout=15"
      # - "--query-timeout=0"              # 0 = 不限制
      # - "--query-wait-timeout=120"
      # - "--idle-transaction-timeout=0"   # 0 = 不限制
      # - "--transaction-timeout=0"        # 0 = 不限制
      # - "--admin-users=admin"
      # - "--stats-users=stats"
      # - "--log-connections=1"
      # - "--log-disconnections=1"

  # 以下是配合 pg_single 的实例级 add-on 样例，按需取消注释。
  # postgrest：把 PostgreSQL schema 暴露为 REST API。
  # - type: postgrest
  #   state: present
  #   instance: pg_single
  #   params:
  #     - "--schema=api"
  #     - "--anon-role=web_anon"
  #     - "--db-pool=20"

  # pgadmin：Web 管理界面；--pg-name 指向本地实例。
  # 默认只监听 127.0.0.1，需要远程访问时再加 --listen=0.0.0.0。
  # - type: pgadmin
  #   state: present
  #   pg_name: pg_single

  # pgexporter：Prometheus 指标导出；--pg-name 指向本地实例。
  # - type: pgexporter
  #   state: present
  #   pg_name: pg_single
  #   params:
  #     - "--monitor-user=pgexporter"

  # documentdb：MongoDB 线协议网关（实例需已启用 documentdb 扩展）。
  # - type: documentdb
  #   state: present
  #   pg_name: pg_single
  #   params:
  #     - "--username=docdb_admin"

  # influx2tsdb：把本地 TimescaleDB 作为 InfluxDB 兼容写入端。
  # - type: influx2tsdb
  #   state: present
  #   pg_name: pg_single
