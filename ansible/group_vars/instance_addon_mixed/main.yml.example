---
# Mixed scenario: one PostgreSQL instance plus add-ons created in the same
# playbook run. Mutually exclusive with single/samehost/crosshost; enable only
# one scenario group at a time in hosts.ini.
#
#   uv run ansible-playbook playbooks/apply.yaml --limit instance_addon_mixed
#
# On hosts that already have pgcli installed, add --tags instance,addon to skip
# the install and unrelated plays; the validation play (tagged always) still
# runs.
#
# `host` must match the bare host name listed in the inventory group. The
# instance play runs before the add-on play, so a local add-on can reference
# an instance created in the same run.
#
# Keep only the images this scenario needs. The pgcli role checks each entry
# and downloads/loads only the missing ones from pgcli_images_http_url; the
# offline pre-check validates exactly this list. pgcli-backup is required
# because pgcli_instance_defaults.backup_target defaults to local.
pgcli_images:
  - image: ghcr.io/mars-base/pgcli/pgcli-pg:18-2.58.0
    archive: pgcli-pg_18-2.58.0.tar
  - image: ghcr.io/mars-base/pgcli/pgcli-backup:2.58.0
    archive: pgcli-backup_2.58.0.tar
  - image: docker.io/edoburu/pgbouncer:v1.25.2-p0
    archive: pgbouncer_v1.25.2-p0.tar

# The host-default config lives in dev, so instances and add-ons without an
# explicit namespace use <deploy home>/.pgcli/dev/pg.yaml. Non-default
# namespaces get their own directory layer (config, data and backup) and a
# disjoint PG port range. The run below initializes both: dev through the
# default config task (pgcli_config_overrides) and default through the
# extra-namespace task, which only runs when <deploy home>/.pgcli/pg.yaml is
# missing.
pgcli_namespace_path: "{{ pgcli_deploy_home }}/.pgcli/dev"

pgcli_config_overrides:
  namespace: dev
  base_dir: "{{ pgcli_data_root }}/dev"
  backup_dir: "{{ pgcli_backup_root }}/dev"
  pg_start_port: 36432
  pg_ssh_port: 43201

pgcli_namespaces:
  - name: default
    path: "{{ pgcli_deploy_home }}/.pgcli"
    base_dir: "{{ pgcli_data_root }}"
    backup_dir: "{{ pgcli_backup_root }}"
    pg_start_port: 35432
    pg_ssh_port: 42201
  - name: dev
    path: "{{ pgcli_deploy_home }}/.pgcli/dev"
    base_dir: "{{ pgcli_data_root }}/dev"
    backup_dir: "{{ pgcli_backup_root }}/dev"
    pg_start_port: 36432
    pg_ssh_port: 43201

pgcli_instances:
  - name: pg_single
    host: debian12-01
    state: started
    autostart: true
    # Overrides pgcli_instance_defaults.extensions; the default list is
    # replaced, not extended.
    extensions:
      - pg_stat_statements
      - pgcrypto
      - pg_trgm
      - timescaledb          # required by the influx2tsdb target
      # documentdb gateway prerequisite (PG 18 only; install rebuilds the
      # image and restarts the instance)
      # - documentdb

pgcli_addons:
  # Local pgbouncer pooling pg_single. Put flags on the entry's `params` list;
  # with a scenario --limit the add-on play does not select
  # group_vars/addon_pgbouncer_single/main.yml (only --limit
  # addon_pgbouncer_single does). For per-type defaults, define
  # addon_pgbouncer_params in this file instead.
  - type: pgbouncer
    state: present
    instance: pg_single
    # Changed params do not apply to an installed container; force reinstalls
    # on every run.
    force: true
    params:
      - "--max-client-conn=100"
      - "--default-pool-size=20"
      # Other optional flags (defaults in parentheses):
      # - "--min-pool-size=0"
      # - "--reserve-pool-size=0"
      # - "--reserve-pool-timeout=5"
      # - "--max-db-connections=50"        # 0 = unlimited
      # - "--max-user-connections=0"       # 0 = unlimited
      # - "--server-idle-timeout=600"
      # - "--server-lifetime=3600"
      # - "--server-connect-timeout=15"
      # - "--query-timeout=0"              # 0 = disabled
      # - "--query-wait-timeout=120"
      # - "--idle-transaction-timeout=0"   # 0 = disabled
      # - "--transaction-timeout=0"        # 0 = disabled
      # - "--admin-users=admin"
      # - "--stats-users=stats"
      # - "--log-connections=1"
      # - "--log-disconnections=1"

  # Instance-scoped add-on examples for pg_single; uncomment as needed.
  # postgrest: expose a PostgreSQL schema as a REST API.
  # - type: postgrest
  #   state: present
  #   instance: pg_single
  #   params:
  #     - "--schema=api"
  #     - "--anon-role=web_anon"
  #     - "--db-pool=20"

  # pgadmin: web UI; --pg-name points at the local instance.
  # Binds 127.0.0.1 by default; add --listen=0.0.0.0 for remote access.
  # - type: pgadmin
  #   state: present
  #   pg_name: pg_single

  # pgexporter: Prometheus metrics exporter; --pg-name points at the local
  # instance.
  # - type: pgexporter
  #   state: present
  #   pg_name: pg_single
  #   params:
  #     - "--monitor-user=pgexporter"

  # documentdb: MongoDB wire-protocol gateway (the instance must have the
  # documentdb extension).
  # - type: documentdb
  #   state: present
  #   pg_name: pg_single
  #   params:
  #     - "--username=docdb_admin"

  # influx2tsdb: expose the local TimescaleDB as an InfluxDB-compatible write
  # endpoint.
  # - type: influx2tsdb
  #   state: present
  #   pg_name: pg_single
