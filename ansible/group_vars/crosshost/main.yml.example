---
# Cross-host primary/replica deployment mode: the primary host is listed
# first in the inventory group (serial: 1 creates it before the replica
# host runs), the replica host follows.
#
# Named namespaces: each instance below selects one with `namespace: <name>`;
# the config is <path>/pg.yaml. Multiple namespaces can coexist in this group.
# dev is the long-lived default config; prod is declared for new instances and
# must be initialized on every host first with `pg config init -o`.
pgcli_namespaces:
  - name: dev
    path: /root/.pgcli
  - name: prod
    path: /root/.pgcli/prod

# Shared S3 repository for instances with backup_target: s3. The endpoint is
# <private_ip>:<port> of pgcli_backup_s3_host, and its CA is copied directly
# from that pgcli-managed store (no manual fetch-ca / fingerprint step). The
# secret key lives in group_vars/crosshost/secrets.yaml (gitignored). See
# site/content/docs/s3-instance/.
pgcli_backup_s3_host: s3-01
pgcli_backup_s3_port: 9000
pgcli_backup_s3_bucket: pgbackup
pgcli_backup_s3_access_key: admin
# Secret key for the access key above. Real deployments keep it in
# group_vars/crosshost/secrets.yaml (gitignored); this placeholder is listed
# here so the variable is easy to find.
pgcli_backup_s3_secret_key: "<secret-key>"
# Optional extras (defaults shown):
# pgcli_backup_s3_region: us-east-1
# pgcli_backup_s3_path: /pgbackrest
# pgcli_backup_s3_no_verify_tls: false
# pgcli_backup_s3_ca_file: /path/to/ca.crt   # manual anchor; skips the copy
# pgcli_backup_s3_ca_sha256: "<sha256>"      # pin the anchor (TOFU / rotation check)
#
# A store that is NOT a pgcli-managed inventory host: omit
# pgcli_backup_s3_host, set pgcli_backup_s3_endpoint to its host:port (no
# scheme) instead, and the role falls back to `pg backup fetch-ca`.

pgcli_instances:
  - name: pg01
    host: debian12-01
    namespace: dev
    state: started
    autostart: true

  # Cross-host read-only replica of pg01.
  - name: pg01_ro1
    host: debian12-02
    replica_of: pg01
    replica_of_host: debian12-01
    namespace: dev
    state: started
    autostart: true

  # Independent primary whose backups go to the standalone S3 store.
  - name: pg02
    host: debian12-02
    namespace: dev
    backup_target: s3
    state: started
    autostart: true
