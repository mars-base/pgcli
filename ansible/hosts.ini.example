# pgcli Ansible inventory
# Copy to hosts.ini and edit for your environment.
#
# Usage:
#   uv run ansible-playbook playbooks/ping.yaml
#   uv run ansible-playbook playbooks/apply.yaml
#   uv run ansible-playbook playbooks/apply.yaml --limit crosshost
#
# [all] is the host pool: every VM is declared here exactly once with its
# connection variables. Every other group only lists bare hostnames.
#
# Add-on testing: each add-on type has its own group, named
# addon_<type>_single (one host) or addon_<type>_cluster (cluster members).
# Select exactly one with --limit; the add-on play derives the type and mode
# from that group name, for example:
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_haproxy_single --tags addon
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_etcd_cluster --tags addon
#
# Add-ons that need a PostgreSQL instance (documentdb, influx2tsdb, pgbouncer,
# pgdog, pgexporter, postgrest) also need the instance tag:
#
#   uv run ansible-playbook playbooks/apply.yaml --limit addon_pgbouncer_single --tags instance,addon
#
# Host order inside a cluster group is the bootstrap order: the first host
# starts the cluster and the rest join it (the add-on play runs serial: 1).
#
# Enable one scenario group set at a time. The single/samehost/crosshost mode
# groups and instance_addon_mixed define pgcli_instances at group level;
# instance_addon_mixed and ha_etcd can also define pgcli_addons. Any active
# scenario/HA group would override the add-on selection for its hosts. The
# scenario groups stay commented out here and while testing add-on groups.

[all]
node1 ansible_host=192.0.2.10 private_ip=192.0.2.10
node2 ansible_host=192.0.2.11 private_ip=192.0.2.11
node3 ansible_host=192.0.2.12 private_ip=192.0.2.12
node4 ansible_host=192.0.2.13 private_ip=192.0.2.13

[all:vars]
ansible_user=root
ansible_port=22

# ── S3 store groups ────────────────────────────────────────────────────────
# Standalone S3-compatible object store (minio/silo/rustfs) for the pgBackRest
# s3 backup target; deploy with playbooks/deploy-s3.yaml. Store-type groups
# are mutually exclusive: activate exactly ONE of [minio_s3] / [silo_s3] /
# [rustfs_s3]. List every node for a multi-host grid (MNSD/MNMD) in cluster
# order; a single host means a single-node store.
# Drives are declared with pgcli_s3_drives in group_vars/<group>/main.yml (or
# per node in host_vars/<host>.yml). deploy-s3.yaml defaults to
# pgcli_s3_group=s3; the [s3] parent lists exactly one active store-type
# child. Keep inactive groups declared but empty so the play pattern still
# resolves without a warning.
[minio_s3]
node1

[silo_s3]
# node1

[rustfs_s3]
# node1

[s3:children]
minio_s3
# silo_s3
# rustfs_s3

# ── Deployment-mode groups ─────────────────────────────────────────────────
# Hosts are grouped by the scenario they exercise, not by environment:
#   single                 one stand-alone instance
#   samehost               primary + same-host replica
#   crosshost              primary and replica on different hosts
#   instance_addon_mixed   one instance plus add-ons (for example pgbouncer)
# Each scenario group defines pgcli_instances (instance_addon_mixed can also
# define pgcli_addons) in group_vars/<group>/; enable one at a time.
# ansible_group_priority keeps the scenario groups ahead of the role marker
# group. Host order inside a group matters: list the primary host first.
#
# Uncomment the group you want to exercise. Keep it commented while testing
# add-ons: a scenario group's pgcli_instances overrides the --limit selection.
# [single]
# node1
#
# [single:vars]
# ansible_group_priority=20

# [samehost]
# node1
#
# [samehost:vars]
# ansible_group_priority=20

# [crosshost]
# node1
# node2
#
# [crosshost:vars]
# ansible_group_priority=20

# [instance_addon_mixed]
# node1
#
# [instance_addon_mixed:vars]
# ansible_group_priority=20

# DCS role: hosts that run the shared etcd cluster. Order matters: the first
# host bootstraps etcd; the rest join it in apply.yaml's serial: 1 add-on play.
# In the co-located layout these hosts also appear in [ha_cluster] below.
# Keep the HA groups commented while testing add-ons: ha_etcd defines
# pgcli_addons at group level and overrides the --limit selection.
# [ha_etcd]
# node2
# node3
# node4

# Role marker: hosts that form the Patroni cluster over the etcd DCS from
# [ha_etcd]. Patroni member names follow the host order below. The DCS group is
# selected with pg_ha_etcd_group in group_vars/ha_cluster.
# [ha_cluster]
# node2
# node3
# node4

