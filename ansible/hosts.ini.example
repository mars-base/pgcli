# pgcli Ansible inventory
# Copy to hosts.ini and edit for your environment.
#
# Usage:
#   uv run ansible-playbook playbooks/ping.yaml
#   uv run ansible-playbook playbooks/apply.yaml
#   uv run ansible-playbook playbooks/apply.yaml --limit crosshost
#
# Hosts are grouped by the deployment mode they exercise, not by environment:
#   single    one stand-alone instance
#   samehost  primary + same-host replica
#   crosshost primary and replica on different hosts
#   ha_cluster  Patroni cluster over a shared etcd DCS (role marker group)
# Each mode group defines its own pgcli_instances in group_vars/<group>/ and
# is responsible only for that mode, so enable one mode group at a time.
# The implicit `all` group still contains every host, so plays target `all`
# and --limit selects the mode to exercise. ansible_group_priority keeps the
# mode groups ahead of the role marker group. Host order inside a group
# matters: list the primary host before the hosts that create cross-host
# replicas from it, because the instance play runs with serial: 1.

[single]
debian12-01 ansible_host=192.0.2.10 private_ip=192.0.2.10 ansible_user=root ansible_port=22

[samehost]
debian12-01 ansible_host=192.0.2.10 private_ip=192.0.2.10 ansible_user=root ansible_port=22

[crosshost]
debian12-01 ansible_host=192.0.2.10 private_ip=192.0.2.10 ansible_user=root ansible_port=22
debian12-02 ansible_host=192.0.2.11 private_ip=192.0.2.11 ansible_user=root ansible_port=22

[single:vars]
ansible_group_priority=20
[samehost:vars]
ansible_group_priority=20
[crosshost:vars]
ansible_group_priority=20

# Role marker: hosts that form one Patroni cluster over a shared etcd DCS.
# Order matters: the first host bootstraps etcd and the Patroni scope.
[ha_cluster]
debian12-02 ansible_host=192.0.2.11 private_ip=192.0.2.11 ansible_user=root ansible_port=22
debian12-03 ansible_host=192.0.2.12 private_ip=192.0.2.12 ansible_user=root ansible_port=22
debian12-04 ansible_host=192.0.2.13 private_ip=192.0.2.13 ansible_user=root ansible_port=22
