{
  "NodeHostName": "localhost",
  "BlockedRolePrefixes": [
    "documentdb",
    "citus",
    "pg",
    "internal_role"
  ],
  "EnableV2Runtime": true,
  "HostConfigurationWatchIntervalMs": 1000,
  "CertificateOptions": {
    "CertType": "PemAutoGenerated"
  },
  "UseLocalHost": false,
  "_comment_TelemetryOptions": "Telemetry is opt-in. pgcli keeps Metrics and Tracing disabled and never injects an OTLP endpoint.",
  "TelemetryOptions": {
    "ServiceName": "documentdb_gateway",
    "Metrics": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317",
      "ExportIntervalMs": 15000
    },
    "Tracing": {
      "Enabled": false,
      "OtlpEndpoint": "http://localhost:4317",
      "SamplerRatio": 1.0,
      "ExportTimeoutMs": 10000
    }
  }
}
